{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wp exec vite build",
    "build:dev": "wp exec vite build --mode dev",
    "build:prd": "wp exec vite build --mode prd",
    "dev": "wp exec vite --host 0.0.0.0 --clearScreen false",
    "deploy:dev": "wp exec vite build --mode dev && wp exec wrangler deploy --env dev",
    "deploy:prd": "echo \"Use root deploy:production with release metadata\" && exit 1",
    "check-types": "wp typecheck",
    "lint": "wp lint",
    "test": "wp test --files vitest.config.ts",
    "test:watch": "wp test --files vitest.config.ts",
    "test:coverage": "wp test --files vitest.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@repo/logger": "workspace:*",
    "@repo/types": "workspace:*",
    "@tanstack/react-query": "^5.99.2",
    "@webpresso/ui": "catalog:",
    "axios": "catalog:",
    "better-auth": "catalog:",
    "date-fns": "^4.1.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "sonner": "catalog:",
    "tw-animate-css": "^1.4.0",
    "zod": "~4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@webpresso/app-config": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "wrangler": "catalog:workers"
  }
}