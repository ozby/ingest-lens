{
  "name": "ingest-lens",
  "version": "0.1.1",
  "private": true,
  "description": "Cloudflare Workers integration-observability app for validating, repairing, delivering, and replaying third-party payloads.",
  "keywords": [
    "cloudflare-workers",
    "event-delivery",
    "integration-observability",
    "queues",
    "react",
    "typescript",
    "vite-plus",
    "webhooks",
    "webpresso",
    "workers-ai"
  ],
  "homepage": "https://github.com/ozby/ingest-lens#readme",
  "bugs": {
    "url": "https://github.com/ozby/ingest-lens/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozby/ingest-lens.git"
  },
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version": "changeset version && bun scripts/sync-release-metadata-version.ts",
    "release:publish": "bun scripts/release-publish.ts",
    "act:ci": "wp ci act --event-name push --workflow-path .github/workflows/ci.yml --execute",
    "act:cleanup": "wp ci act --event-name workflow_dispatch --workflow-path .github/workflows/cleanup-stale-neon-e2e-branches.yml --job cleanup --execute",
    "act:e2e": "wp ci act --event-name workflow_dispatch --workflow-path .github/workflows/e2e-act.yml --job e2e-local --execute",
    "build": "vp run build",
    "catalog:check": "wp audit catalog-drift",
    "audit:secret-provider-quarantine": "WP_SKIP_UPDATE_CHECK=1 wp audit secret-provider-quarantine",
    "check": "vp check",
    "clean": "vp run clean",
    "client:bundle:check": "wp audit bundle-budget apps/client/dist --max-js-asset-bytes 512000 --max-html-eager-js-asset-bytes 262144 --max-html-eager-js-total-bytes 393216",
    "dev": "with-secrets -- vp run dev",
    "dev:offline": "vp run dev",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "wp lint",
    "lint:repo": "wp lint",
    "test": "wp test --file vitest.config.ts",
    "check-types": "wp typecheck",
    "commitlint": "commitlint",
    "secretlint": "secretlint",
    "setup:agent": "wp setup",
    "postinstall": "test -n \"$CI\" || wp setup",
    "prepare": "husky",
    "docs:check": "wp audit docs-frontmatter",
    "blueprints:check": "wp audit blueprint-lifecycle",
    "e2e": "wp e2e",
    "ai:eval": "bun ./scripts/run-mapping-eval.ts",
    "probes:lab": "bun scripts/probes/consistency-lab/run-all.ts",
    "verify:paths": "WP_SKIP_UPDATE_CHECK=1 wp audit guardrails",
    "verify:secrets": "WP_SKIP_UPDATE_CHECK=1 wp audit no-dev-vars",
    "typecheck": "wp typecheck",
    "mutation": "wp test --mutation",
    "test:mutation": "wp test --mutation",
    "qa": "wp lint && wp typecheck && vp run test && wp test --mutation && wp e2e",
    "deploy:preview": "wp deploy --lane preview_main",
    "deploy:production": "wp deploy --lane prd",
    "deploy:dry-run": "wp deploy --lane prd --dry-run"
  },
  "dependencies": {
    "rulesync": "8.15.1"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@playwright/test": "catalog:",
    "@repo/runtime-env-local": "workspace:*",
    "@secretlint/secretlint-rule-preset-recommend": "^9.3.0",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/typescript-checker": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@webpresso/agent-config": "catalog:",
    "husky": "catalog:",
    "jsdom": "^29.1.1",
    "node-addon-api": "^8.5.0",
    "react": "catalog:",
    "secretlint": "^9.3.0",
    "tsx": "catalog:",
    "typescript": "catalog:tooling",
    "vite": "catalog:tooling",
    "vite-plus": "catalog:",
    "vitest": "catalog:tooling"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1"
}