{
  "version": 1,
  "architectureDocs": ["docs/architecture.md"],
  "requiredFiles": [
    "blueprints/completed/system-clarity-hardening/_overview.md",
    "blueprints/completed/surface-test-traceability-hardening/_overview.md",
    "blueprints/archived/public-ci-surface-adoption/_overview.md",
    "blueprints/completed/2026-06-02-ingest-lens-preview-production-lanes.md"
  ],
  "rules": [
    {
      "id": "reviewer-path-mentions-architecture-contract",
      "paths": ["README.md", "docs/architecture.md"],
      "mustContain": ["docs/architecture.contract.json"]
    }
  ],
  "blueprintPolicy": {
    "enabled": true,
    "blueprintGlobs": ["blueprints/in-progress/**/*.md", "blueprints/planned/**/*.md"],
    "architectureDocGlobs": ["docs/architecture.md"],
    "requireArchitectureLinks": true,
    "requireBeforeAfterWhenArchitectureChanging": true,
    "architectureChangeMarkers": [
      "## Architecture Overview",
      "runtime seams",
      "Modify: `docs/architecture.md`"
    ],
    "beforeHeading": "Architecture before",
    "afterHeading": "Architecture after",
    "exemptStatuses": ["completed", "archived"]
  },
  "deployment": {
    "canonicalProductionTarget": "ingest-lens.ozby.dev",
    "workers": ["ingest-lens-api", "ingest-lens-client"],
    "lanes": {
      "dev": {
        "kind": "persistent",
        "clientUrl": "https://dev.ingest-lens.ozby.dev",
        "apiUrl": "https://api.dev.ingest-lens.ozby.dev"
      },
      "preview_main": {
        "kind": "main-preview",
        "clientUrl": "https://preview-main.ingest-lens.ozby.dev",
        "apiUrl": "https://api.preview-main.ingest-lens.ozby.dev",
        "trigger": "push main"
      },
      "preview_pr": {
        "kind": "ephemeral-pr",
        "clientUrlPattern": "https://preview-pr-<n>.ingest-lens.ozby.dev",
        "apiUrlPattern": "https://api.preview-pr-<n>.ingest-lens.ozby.dev",
        "cleanup": "wrangler delete + pulumi destroy on PR close"
      },
      "prd": {
        "kind": "release-gated-production",
        "clientUrl": "https://ingest-lens.ozby.dev",
        "apiUrl": "https://api.ingest-lens.ozby.dev",
        "releaseGate": "version_pr metadata + matching semantic releaseVersion"
      }
    }
  }
}