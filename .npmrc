# @webpresso/@ozby packages are published to GitHub Packages.
# Keep a non-secret fallback so local commands that do not touch the registry
# can still read config; installs/publishes still require a real token.
@webpresso:registry=https://npm.pkg.github.com
@ozby:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GH_PACKAGES_TOKEN:-__GH_PACKAGES_TOKEN_UNSET__}
always-auth=true
